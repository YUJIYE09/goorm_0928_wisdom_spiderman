[
  {"id":"original-001","textOriginal":null,"textKo":"큰 힘보다 먼저 필요한 건, 그 힘을 어디에 쓸지 생각하는 마음이다.","speaker":"오리지널 문장","work":"Spider Quotes 오리지널 컬렉션","year":null,"category":"책임","tags":["선택","힘"],"sourceUrl":null,"rightsStatus":"approved-for-use","contentType":"original"},
  {"id":"original-002","textOriginal":null,"textKo":"도움을 청하는 용기도 누군가를 구하는 용기만큼 크다.","speaker":"오리지널 문장","work":"Spider Quotes 오리지널 컬렉션","year":null,"category":"용기","tags":["도움","마음"],"sourceUrl":null,"rightsStatus":"approved-for-use","contentType":"original"},
  {"id":"original-003","textOriginal":null,"textKo":"완벽한 순간을 기다리다 보면, 지금 할 수 있는 선행을 놓친다.","speaker":"오리지널 문장","work":"Spider Quotes 오리지널 컬렉션","year":null,"category":"실천","tags":["현재","선행"],"sourceUrl":null,"rightsStatus":"approved-for-use","contentType":"original"},
  {"id":"original-004","textOriginal":null,"textKo":"넘어졌다는 사실보다 다시 일어서는 이유가 너를 더 잘 말해 준다.","speaker":"오리지널 문장","work":"Spider Quotes 오리지널 컬렉션","year":null,"category":"회복","tags":["도전","성장"],"sourceUrl":null,"rightsStatus":"approved-for-use","contentType":"original"},
  {"id":"original-005","textOriginal":null,"textKo":"작은 친절은 작게 끝나지 않는다. 누군가의 하루를 바꿀 수 있다.","speaker":"오리지널 문장","work":"Spider Quotes 오리지널 컬렉션","year":null,"category":"친절","tags":["선행","희망"],"sourceUrl":null,"rightsStatus":"approved-for-use","contentType":"original"},
  {"id":"original-006","textOriginal":null,"textKo":"두려움이 사라진 뒤에 움직이는 게 아니라, 두려워도 옳은 쪽으로 움직이는 게 용기다.","speaker":"오리지널 문장","work":"Spider Quotes 오리지널 컬렉션","year":null,"category":"용기","tags":["두려움","선택"],"sourceUrl":null,"rightsStatus":"approved-for-use","contentType":"original"},
  {"id":"original-007","textOriginal":null,"textKo":"혼자 해내는 능력보다 함께 해내는 마음이 더 멀리 간다.","speaker":"오리지널 문장","work":"Spider Quotes 오리지널 컬렉션","year":null,"category":"관계","tags":["협력","우정"],"sourceUrl":null,"rightsStatus":"approved-for-use","contentType":"original"},
  {"id":"original-008","textOriginal":null,"textKo":"오늘의 선택은 작아 보여도 내일의 내가 걸어갈 길을 만든다.","speaker":"오리지널 문장","work":"Spider Quotes 오리지널 컬렉션","year":null,"category":"선택","tags":["오늘","미래"],"sourceUrl":null,"rightsStatus":"approved-for-use","contentType":"original"},
  {"id":"original-009","textOriginal":null,"textKo":"모든 사람을 구할 수는 없어도, 눈앞의 한 사람에게 손을 내밀 수는 있다.","speaker":"오리지널 문장","work":"Spider Quotes 오리지널 컬렉션","year":null,"category":"책임","tags":["도움","실천"],"sourceUrl":null,"rightsStatus":"approved-for-use","contentType":"original"},
  {"id":"original-010","textOriginal":null,"textKo":"실수는 너의 이름이 아니다. 실수 뒤에 하는 행동이 다음 장을 쓴다.","speaker":"오리지널 문장","work":"Spider Quotes 오리지널 컬렉션","year":null,"category":"성장","tags":["실수","다시 시작"],"sourceUrl":null,"rightsStatus":"approved-for-use","contentType":"original"},
  {"id":"original-011","textOriginal":null,"textKo":"힘을 가졌다면 자랑할 이유보다 지켜야 할 사람이 먼저 떠올라야 한다.","speaker":"오리지널 문장","work":"Spider Quotes 오리지널 컬렉션","year":null,"category":"책임","tags":["힘","보호"],"sourceUrl":null,"rightsStatus":"approved-for-use","contentType":"original"},
  {"id":"original-012","textOriginal":null,"textKo":"누군가의 하루를 밝히는 데 거창한 능력은 필요하지 않다.","speaker":"오리지널 문장","work":"Spider Quotes 오리지널 컬렉션","year":null,"category":"희망","tags":["친절","일상"],"sourceUrl":null,"rightsStatus":"approved-for-use","contentType":"original"},
  {"id":"original-013","textOriginal":null,"textKo":"도망치고 싶은 마음을 알아차린 순간, 선택할 기회도 시작된다.","speaker":"오리지널 문장","work":"Spider Quotes 오리지널 컬렉션","year":null,"category":"용기","tags":["두려움","선택"],"sourceUrl":null,"rightsStatus":"approved-for-use","contentType":"original"},
  {"id":"original-014","textOriginal":null,"textKo":"세상을 한 번에 바꾸려 하지 말고, 오늘 만난 한 사람부터 살펴보자.","speaker":"오리지널 문장","work":"Spider Quotes 오리지널 컬렉션","year":null,"category":"친절","tags":["실천","공감"],"sourceUrl":null,"rightsStatus":"approved-for-use","contentType":"original"},
  {"id":"original-015","textOriginal":null,"textKo":"진짜 강함은 이기는 데서만 드러나지 않는다. 멈춰야 할 때 멈추는 데도 있다.","speaker":"오리지널 문장","work":"Spider Quotes 오리지널 컬렉션","year":null,"category":"절제","tags":["강함","선택"],"sourceUrl":null,"rightsStatus":"approved-for-use","contentType":"original"},
  {"id":"original-016","textOriginal":null,"textKo":"사과는 약함의 표시가 아니라, 관계를 다시 세우려는 첫 행동이다.","speaker":"오리지널 문장","work":"Spider Quotes 오리지널 컬렉션","year":null,"category":"관계","tags":["사과","책임"],"sourceUrl":null,"rightsStatus":"approved-for-use","contentType":"original"},
  {"id":"original-017","textOriginal":null,"textKo":"도움을 받았던 기억을 다음 사람에게 건네면 친절은 이어진다.","speaker":"오리지널 문장","work":"Spider Quotes 오리지널 컬렉션","year":null,"category":"친절","tags":["나눔","연결"],"sourceUrl":null,"rightsStatus":"approved-for-use","contentType":"original"},
  {"id":"original-018","textOriginal":null,"textKo":"망설임이 길어질수록, 옳다고 믿는 작은 행동부터 시작하자.","speaker":"오리지널 문장","work":"Spider Quotes 오리지널 컬렉션","year":null,"category":"실천","tags":["시작","용기"],"sourceUrl":null,"rightsStatus":"approved-for-use","contentType":"original"},
  {"id":"original-019","textOriginal":null,"textKo":"누구나 가면 뒤에 숨고 싶을 때가 있다. 그래도 진심은 모습을 드러낸다.","speaker":"오리지널 문장","work":"Spider Quotes 오리지널 컬렉션","year":null,"category":"진실","tags":["정직","자기이해"],"sourceUrl":null,"rightsStatus":"approved-for-use","contentType":"original"},
  {"id":"original-020","textOriginal":null,"textKo":"책임은 짐만이 아니다. 내가 세상에 보탤 수 있다는 가능성이기도 하다.","speaker":"오리지널 문장","work":"Spider Quotes 오리지널 컬렉션","year":null,"category":"책임","tags":["가능성","의미"],"sourceUrl":null,"rightsStatus":"approved-for-use","contentType":"original"},
  {"id":"original-021","textOriginal":null,"textKo":"어제보다 한 걸음 나아갔다면, 그 하루는 충분히 의미가 있다.","speaker":"오리지널 문장","work":"Spider Quotes 오리지널 컬렉션","year":null,"category":"성장","tags":["꾸준함","희망"],"sourceUrl":null,"rightsStatus":"approved-for-use","contentType":"original"},
  {"id":"original-022","textOriginal":null,"textKo":"상대의 사정을 들으려는 순간, 판단은 이해로 바뀔 수 있다.","speaker":"오리지널 문장","work":"Spider Quotes 오리지널 컬렉션","year":null,"category":"공감","tags":["경청","관계"],"sourceUrl":null,"rightsStatus":"approved-for-use","contentType":"original"},
  {"id":"original-023","textOriginal":null,"textKo":"희망은 문제가 없다는 믿음이 아니라, 문제 속에서도 길을 찾겠다는 마음이다.","speaker":"오리지널 문장","work":"Spider Quotes 오리지널 컬렉션","year":null,"category":"희망","tags":["인내","회복"],"sourceUrl":null,"rightsStatus":"approved-for-use","contentType":"original"},
  {"id":"original-024","textOriginal":null,"textKo":"힘든 날에도 누군가를 웃게 했다면, 너는 이미 좋은 일을 해낸 거야.","speaker":"오리지널 문장","work":"Spider Quotes 오리지널 컬렉션","year":null,"category":"희망","tags":["친절","위로"],"sourceUrl":null,"rightsStatus":"approved-for-use","contentType":"original"},
  {"id":"original-025","textOriginal":null,"textKo":"정답을 몰라도 괜찮다. 해를 줄이고 도움을 더하는 방향부터 고르자.","speaker":"오리지널 문장","work":"Spider Quotes 오리지널 컬렉션","year":null,"category":"선택","tags":["판단","배려"],"sourceUrl":null,"rightsStatus":"approved-for-use","contentType":"original"},
  {"id":"original-026","textOriginal":null,"textKo":"용서는 과거를 지우는 일이 아니라, 과거가 내 다음 행동을 정하지 못하게 하는 일이다.","speaker":"오리지널 문장","work":"Spider Quotes 오리지널 컬렉션","year":null,"category":"회복","tags":["용서","자유"],"sourceUrl":null,"rightsStatus":"approved-for-use","contentType":"original"},
  {"id":"original-027","textOriginal":null,"textKo":"혼자 버티는 것만이 강함은 아니다. 믿을 사람에게 기대는 것도 용기다.","speaker":"오리지널 문장","work":"Spider Quotes 오리지널 컬렉션","year":null,"category":"용기","tags":["도움","관계"],"sourceUrl":null,"rightsStatus":"approved-for-use","contentType":"original"},
  {"id":"original-028","textOriginal":null,"textKo":"눈에 띄지 않는 선택도 누군가에게는 세상을 지키는 일이 된다.","speaker":"오리지널 문장","work":"Spider Quotes 오리지널 컬렉션","year":null,"category":"책임","tags":["일상","선택"],"sourceUrl":null,"rightsStatus":"approved-for-use","contentType":"original"},
  {"id":"original-029","textOriginal":null,"textKo":"실패가 계획을 바꿀 수는 있어도, 네가 다시 시도할 이유까지 빼앗지는 못한다.","speaker":"오리지널 문장","work":"Spider Quotes 오리지널 컬렉션","year":null,"category":"회복","tags":["실패","도전"],"sourceUrl":null,"rightsStatus":"approved-for-use","contentType":"original"},
  {"id":"original-030","textOriginal":null,"textKo":"오늘 네가 지킨 작은 약속 하나가 내일의 신뢰를 만든다.","speaker":"오리지널 문장","work":"Spider Quotes 오리지널 컬렉션","year":null,"category":"신뢰","tags":["약속","책임"],"sourceUrl":null,"rightsStatus":"approved-for-use","contentType":"original"}
